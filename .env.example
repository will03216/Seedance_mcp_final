# BytePlus ModelArk bearer token — required for all video generation tools
ARK_API_KEY=your-modelark-api-key

# BytePlus IAM credentials — required for asset library tools (portrait/sensitive images)
ARK_AK=your-iam-access-key
ARK_SK=your-iam-secret-key

# AI MediaKit bearer token — required only for video upscaling (seedance_upscale_video).
# Separate from ARK_API_KEY; create one in the AI MediaKit console.
MEDIAKIT_API_KEY=your-ai-mediakit-api-key

# Optional tuning
# SEEDANCE_SUBMIT_TIMEOUT=30
# SEEDANCE_POLL_TIMEOUT=15
# SEEDANCE_MAX_RETRIES=3
# SEEDANCE_DEBUG_RAW=0
# SEEDANCE_ASSET_POLL_INTERVAL=10
# SEEDANCE_ASSET_POLL_TIMEOUT=120
# SEEDANCE_MEDIAKIT_BASE_URL=https://mediakit.ap-southeast-1.bytepluses.com/api/v1
# SEEDANCE_MEDIAKIT_CACHE_TTL=86400

# HTTP server mode (set to "sse" for Docker / hosted deployments)
# MCP_TRANSPORT=stdio
# PORT=8000
# MCP_AUTH_TOKEN=your-strong-random-token
